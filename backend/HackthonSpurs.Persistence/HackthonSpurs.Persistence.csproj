<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Preserve published CLR identities and the namespace used when scaffolding migrations. -->
    <AssemblyName>HackthonSpurs.Documents</AssemblyName>
    <RootNamespace>HackthonSpurs.Documents.Persistence</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../HackthonSpurs.Application/HackthonSpurs.Application.csproj" />
    <ProjectReference Include="../HackthonSpurs.Domain/HackthonSpurs.Domain.csproj" />
    <ProjectReference Include="../HackthonSpurs.Resources/HackthonSpurs.Resources.csproj" />
  </ItemGroup>
</Project>
