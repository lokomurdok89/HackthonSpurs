# Local use only. Set a unique secret in .env before the first database start.
POSTGRES_PASSWORD=
API_PORT=5080
# Only the complete single-host stack publishes the web gateway.
WEB_PORT=8080
UPLOAD_MAX_BYTES=20971520

# Optional local demo only. Supply independent, private initial passwords in .env.
Auth__DemoSeedEnabled=false
Auth__DemoAdminPassword=
Auth__DemoReaderPassword=

# In normal mode, required to create the first administrator on an empty workspace; keep credentials local.
Auth__BootstrapUsername=
Auth__BootstrapPassword=

# Optional compose.spur.yaml only. The default and synthetic stacks need no SPUR key.
SPUR_OCR_ENDPOINT=https://ai.spuric.com/v1/chat/completions
SPUR_OCR_MODEL=spur-vision
SPUR_OCR_IMAGE_TARGET_BYTES=79999
SPUR_OCR_MAX_JSON_BYTES=128000
SPUR_OCR_ADAPTIVE_MONOCHROME=true
SPUR_API_KEY=
SPUR_EMBEDDINGS_ENABLED=true
SPUR_BASE_URL=https://ai.spuric.com/v1
SPUR_EMBED_MODEL=spur-embed
SPUR_EMBED_VERSION=1
SPUR_EMBED_DIMENSIONS=768
