# Local use only. Set a unique secret in .env before the first database start.
POSTGRES_PASSWORD=
API_PORT=5080
UPLOAD_MAX_BYTES=20971520

# SPUR Compute OpenAI-compatible embeddings API (https://ai.spuric.com/v1/embeddings)
SPUR_BASE_URL=https://ai.spuric.com/v1
SPUR_API_KEY=
SPUR_EMBED_MODEL=bge-m3

# SPUR Vision model for OCR on scanned PDFs and photos (PNG/JPEG)
SPUR_VISION_API_KEY=
SPUR_VISION_MODEL=
# Optional override if the vision endpoint differs from SPUR_BASE_URL
SPUR_VISION_BASE_URL=
