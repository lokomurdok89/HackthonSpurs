# Local use only. Set a unique secret in .env before the first database start.
POSTGRES_PASSWORD=
API_PORT=5080
UPLOAD_MAX_BYTES=20971520

# Optional compose.spur.yaml only. The default and synthetic stacks need no SPUR key.
SPUR_OCR_ENDPOINT=https://ai.spuric.com/v1/chat/completions
SPUR_OCR_MODEL=spur-vision
SPUR_API_KEY=
SPUR_EMBEDDINGS_ENABLED=true
SPUR_BASE_URL=https://ai.spuric.com/v1
SPUR_EMBED_MODEL=spur-embed
SPUR_EMBED_VERSION=1
SPUR_EMBED_DIMENSIONS=768
